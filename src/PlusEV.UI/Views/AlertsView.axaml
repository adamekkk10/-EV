<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PlusEV.UI.ViewModels"
             x:Class="PlusEV.UI.Views.AlertsView"
             x:DataType="vm:AlertsViewModel"
             Padding="20">
    <Grid RowDefinitions="Auto,Auto,Auto,*">
        <TextBlock Grid.Row="0" Text="Alerts" FontSize="22" FontWeight="SemiBold" Foreground="#E6ECF5" />
        <Border Grid.Row="1" Classes="card">
            <StackPanel Spacing="8">
                <TextBlock Text="Channels" FontWeight="SemiBold" Foreground="#8793A8" />
                <ItemsControl ItemsSource="{Binding ChannelNames}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Foreground="#E6ECF5" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                    <Button Content="Test Telegram" Command="{Binding TestChannelCommand}" CommandParameter="telegram" />
                    <Button Content="Test Discord"  Command="{Binding TestChannelCommand}" CommandParameter="discord" />
                    <Button Content="Test Desktop"  Command="{Binding TestChannelCommand}" CommandParameter="desktop" />
                </StackPanel>
            </StackPanel>
        </Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
            <Button Classes="primary" Content="Refresh log" Command="{Binding RefreshCommand}" />
        </StackPanel>
        <DataGrid Grid.Row="3" ItemsSource="{Binding RecentLog}" IsReadOnly="True"
                  Background="#141821" BorderBrush="#2C3444" BorderThickness="1">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Sent"      Binding="{Binding SentAt, StringFormat='{}{0:g}'}" />
                <DataGridTextColumn Header="Channel"   Binding="{Binding Channel}" />
                <DataGridTextColumn Header="Title"     Binding="{Binding Title}" Width="2*" />
                <DataGridTextColumn Header="Delivered" Binding="{Binding Delivered}" />
                <DataGridTextColumn Header="Error"     Binding="{Binding Error}" Width="2*" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
